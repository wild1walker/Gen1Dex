-- Sharing metadata: read by tooling and the mod manager's detail pane.
return {
  summary = "The Pokedex with a POKeMON beside every entry: the party icon "
    .. "to the left of each row, blacked out to a silhouette until you have "
    .. "seen that species, and three pages behind every entry. Boxed top and "
    .. "bottom like the rest of the set, with the icon column ruled off from "
    .. "the names.",
  author = "wild1walker",
  tags = { "ui", "pokedex", "quality-of-life", "icons" },
  credits = {
    { who = "Gen1Recomp", for_ = "the screen, palette and registry seams "
      .. "this mod is built on" },
    { who = "pret/pokered", for_ = "home/text.asm, where the box this mod "
      .. "draws into is defined" },
    { who = "ShaneMcGovernIE", for_ = "useful_dex, which got to this ground "
      .. "first -- the stats page, the movelist and the three list views "
      .. "were all there before they were here.  No code of its is used; the "
      .. "two conflict rather than share, but prior art is worth saying" },
    { who = "unique_menu_icons, new_icons, and the HGSS / Gold-Silver / "
      .. "Crystal sprite packs", for_ = "the optional art this mod draws "
      .. "when it is installed.  None of it is vendored here" },
    { who = "Nintendo / Creatures / GAME FREAK", for_ = "Pokemon Red, Blue "
      .. "and Yellow.  Unofficial fan mod, no affiliation, no endorsement" },
  },
  compat = { engine = ">=0.0.0-0 <2.0.0", modApi = 2, games = { "gen1" } },
  differences = {
    changed = {
      "the dex list draws a party icon in the margin left of every row, on the vanilla list's own 16-pixel pitch",
      "both screens are boxed top and bottom -- a header box naming what you are looking at, a footer box saying what you can do about it -- with the body ruled into columns between them, which is what costs the list its seventh row: six 16-pixel rows fill the 96 pixels between the boxes exactly",
      "the owned ball moved out from one blank glyph after the name into a fixed column of its own, because a column of balls answers what do I still need at a glance and a scatter of them following the end of each word does not",
      "an oversized sprite is scaled into the well rather than drawn at 1:1 from the top of it: a 96-pixel one from a sprite pack ran 38 pixels past the bottom, through the rule and across all three lines of the description",
      "the sprite is centred in its well rather than stood on the floor of it, so a picture shorter than 56 pixels no longer leaves all of its slack in one band above it",
      "the entry page is the first of three rather than the only one -- its sprite, kind, height, weight and description are unchanged, and A now carries on past the end of the text instead of closing",
      "the list and the entry are drawn over the plain grey ramp rather than the dex's BROWNMON, because a named palette paints shade 1 a colour and the chrome here is meant to read as black line art (SPECIES COLOURS puts the brown back)",
      "the entry's sprite resolves through the BATTLE kind first, with the dex kind as the fallback, so a sprite or animation mod's replacement art is what the page shows",
      "the SEEN / OWN footer counts stay the whole dex's in every view, so they count your Pokedex rather than the filter you are reading it through",
      "the overworld START menu's dex row reads DEX rather than POKeDEX -- renamed through the ui.start_menu.items hook, so the row keeps its position, its key and its onSelect, and every other row is the engine's own; the SAVE panel's dex count and the list header are separate text and are unchanged",
    },
    added = {
      "an undiscovered species is drawn as a black silhouette -- a draw-time tint rather than a palette zone, which is the only version of it that also holds for an icon mod's authored full-colour art",
      "a palette zone per discovered row, so all six POKeMON on screen wear their own species colours at once, where the Game Boy could show four",
      "SELECT cycles the list between POKeDEX, POKeDEX A-Z (seen only, sorted by name, dex numbers kept) and POKeDEX CAUGHT (owned only), keeping the cursor on the same species wherever it survives the switch",
      "a STATS page: the five base stats, their total as BST, the types, and what the species evolves into",
      "a MOVES page: the level-up learnset and then the TM/HM list, eight rows to a page, with the machine numbers read off the ITEMS registry rather than a hard-coded table so a mod that adds TM51 needs no help",
      "STAB moves marked with a chip in their own type's colour, and each type on the STATS page underlined in its own -- both marked true-colour so the SGB shade remap cannot turn them into arbitrary greys",
      "LEFT and RIGHT walk the entry's three pages, wrapping both ways, with an arrow at each end of the header saying so -- A still advances, but a reader one page too far can go back rather than forward twice, and unlike A the page keys do not wait for the description to be read out",
      "UP/DOWN on the first two entry pages opens the previous or next species you have SEEN, wrapping at both ends, and pages the movelist on the third; the page you were reading survives the step",
      "a row of three pips in the list header showing which of the three views you are in, which costs 21 pixels where a third word would cost sixty",
      "evolution labels taken from the merged evolution_methods registry's describe(), so a mod-added evolution method describes itself on this page",
      "optional animated sprites from crystal_animated_sprites_with_shiny_visuals, played on the DEX page when that mod is installed",
      "UP on the first row and DOWN on the last wrap around, and a held direction keeps scrolling",
      "AREA opens on an entry you have never met -- a two-row AREA / QUIT menu where vanilla's side menu returns early -- on the species the row names rather than the one its position would have named, which is what keeps it right in the A-Z and CAUGHT views",
      "a line under the AREA map saying how to get there, for all 151: the map where the species has the biggest share of the encounters, that map's own level band and a rarity worked out from Gen 1's ten slot buckets, read out of the live encounter tables, with the evolution table as the fallback for anything that is wild nowhere",
      "when neither table has anything -- the four statics, or a species a mod is deliberately withholding -- the box says NO RECORD REMAINS / GO ADVENTURING! rather than leaving a blank map, which cannot be told apart from a broken one; a withheld species draws the same words as an unknown one on purpose, so a seal does not read as one",
      "the AREA header is measured before it is drawn: vanilla writes <NAME> AREA UNKNOWN into a 19-column strip without checking, so MOLTRES AREA UNKNOWN ran off the right edge mid-word.  The nest line is shortened only when it overflows; the unknown line drops the word AREA, which the screen is already called, and reads MOLTRES UNKNOWN",
      "the first A takes that line down and the second closes the screen the way A always did; with it down the AREA screen is the plain town map again, d-pad and name banner included, and START puts the line back",
      "the nickname prompt after a catch is asked over the screen it interrupted rather than over the blank white field AskName wipes to: the dex entry for a species the dex has never held -- the same screen instance the page was just drawn from, so the page a player left on STATS comes back on STATS and no cry plays twice -- and for anything else the battle it was caught on, with the closed ball still resting where the POKeMON was, put down when the question is answered rather than before it is asked",
      "a caption hook for other mods -- mod.find(\"Gen1Dex\").exports.area.provide -- so a mod that adds a spawn can write the line for its own species, or withhold one for a spawn that is still behind an event",
      "SPECIES COLOURS, SELECT VIEWS, UP/DOWN SPECIES, LIST WRAPS, HOLD TO SCROLL, START SAYS DEX, AREA ON UNSEEN, AREA HINTS and NAME IN PLACE, in the mod manager",
    },
    known = {
      "useful_dex and pokedex_plus are declared conflicts rather than merely incompatible: all three register DexEntryMenu and PokedexMenu, and the last one loaded would win silently",
      "a species with several evolutions loses the method labels -- one evolution gets two lines, how and then into what, but two or three (EEVEE) get one line each and just the name, because the column is ten glyphs wide, LEVEL 16 IVYSAUR is sixteen, and three rows is all that fits under the types",
      "there are no stat bars on the STATS page, deliberately: a bar wide enough to read costs 24 pixels, the left column has none spare, and taking them from the right column truncates CHARMELEON -- a number you can compare is worth more than a bar you cannot",
      "the list draws six rows rather than the vanilla seven: the header and footer boxes cost a tile row each end, and the icons were sized to the vanilla 16-pixel pitch rather than the pitch grown to fit them",
      "the icon in a blank row is the real species' icon blacked out, not a generic shape, so on a vanilla boot -- where a Gen 1 icon is a GROUP icon shared by many species (BIRD, BUG, MON) -- the silhouette says which group it is; with unique_menu_icons or new_icons installed it says rather more",
    },
  },
}
